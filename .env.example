# Create a Supabase project and apply the SQL migration in supabase/migrations.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use the Supabase publishable key (preferred) or legacy anon key.
# Never put the service_role or secret key in a VITE_ variable.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Existing rendered branding defaults to GLA University. Confirm before production.
VITE_INSTITUTION_NAME=GLA University
